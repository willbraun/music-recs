{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Music Recs",
	"version": "0.1.0",
	"identifier": "com.willbraun.musicrecs",
	"build": {
		"frontendDist": "./splash",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg"],
		"category": "Music",
		"macOS": {
			"minimumSystemVersion": "14.0"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
